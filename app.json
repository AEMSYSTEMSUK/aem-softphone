{
  "expo": {
    "name": "The One MSP Phone",
    "slug": "theonemsp-phone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.aemsystems.theonemspphone",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The One MSP Phone uses the microphone for calls.",
        "NSContactsUsageDescription": "The One MSP Phone searches your contacts so you can call them.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uk.co.aemsystems.theonemspphone",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-contacts",
      "@config-plugins/react-native-webrtc"
    ],
    "scheme": "theonemspphone",
    "extra": {
      "apiBase": "https://one.aemtech.co.uk/api"
    }
  }
}
